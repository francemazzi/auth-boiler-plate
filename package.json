{
  "name": "create-express-auth",
  "version": "2.0.1",
  "type": "module",
  "description": "Create a new Express.js project with authentication using: npx create-express-auth my-app",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "./bin/block-install.cjs",
  "bin": {
    "create-express-auth": "./bin/create-express-auth.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/francemazzi/auth-boiler-plate"
  },
  "scripts": {
    "prepare": "husky install",
    "dev": "tsx watch src/infrastructure/http/server.ts",
    "build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/infrastructure/http/public', 'dist/infrastructure/http/public', {recursive: true})\"",
    "start": "node dist/infrastructure/http/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest -c jest.integration.config.mjs --passWithNoTests",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "clean": "rimraf dist",
    "config:init": "node ./bin/init-config.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "preferGlobal": false,
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "authentication",
    "boilerplate",
    "starter",
    "template",
    "create-app",
    "cli"
  ],
  "author": "Francesco Mazzi",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@types/cookie-parser": "^1.4.9",
    "axios": "1.6.7",
    "bcryptjs": "2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.18.2",
    "express-validator": "7.0.1",
    "glob": "10.3.10",
    "jsonwebtoken": "9.0.2",
    "pg": "^8.13.0",
    "lru-cache": "10.2.0",
    "qrcode": "1.5.3",
    "speakeasy": "2.0.0",
    "swagger-jsdoc": "6.2.8",
    "swagger-ui-express": "5.0.0",
    "winston": "3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.12",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "20.11.20",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "1.5.5",
    "@types/speakeasy": "2.0.10",
    "@types/supertest": "2.0.16",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.6",
    "@typescript-eslint/eslint-plugin": "7.1.0",
    "@typescript-eslint/parser": "7.1.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "husky": "9.0.11",
    "jest": "29.7.0",
    "jest-mock-extended": "3.0.5",
    "lint-staged": "15.2.2",
    "prettier": "3.2.5",
    "prisma": "^7.3.0",
    "rimraf": "5.0.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0"
  }
}
